# Production env variables for Timeweb deploy via Dokploy
# Скопируйте в .env (или вставьте в Dokploy UI) и измените под ваш сервер

# Database
POSTGRES_USER=hrportal
POSTGRES_PASSWORD=hrportal_strong_password_change_me
POSTGRES_DB=hrportal

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_strong_password_change_me

# Public URLs (используются браузером — должны быть доступны снаружи).
# Замените sitehrportal.ru на ваш домен; только https, без прямых IP/портов.
NEXT_PUBLIC_API_URL=https://sitehrportal.ru/api
NEXT_PUBLIC_KEYCLOAK_URL=https://sitehrportal.ru/auth

# Backend (для JWT validation, читает Keycloak с его публичного URL)
KEYCLOAK_PUBLIC_URL=https://sitehrportal.ru/auth

# Origin фронта для CORS backend (без него CORS открыт для всех — только для отладки)
FRONTEND_ORIGIN=https://sitehrportal.ru
