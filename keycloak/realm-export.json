{
  "realm": "hr-portal",
  "enabled": true,
  "displayName": "HR Portal",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "Regular employee"
      },
      {
        "name": "manager",
        "description": "Department manager"
      },
      {
        "name": "hr",
        "description": "HR specialist"
      }
    ]
  },
  "clients": [
    {
      "clientId": "hr-portal-app",
      "name": "HR Portal Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost/*",
        "http://92.53.124.249:3101/*",
        "http://92.53.124.249/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost",
        "http://92.53.124.249:3101",
        "http://92.53.124.249"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "employee1",
      "enabled": true,
      "email": "employee1@gazprom-cps.ru",
      "firstName": "Иван",
      "lastName": "Петров",
      "credentials": [
        {
          "type": "password",
          "value": "employee1",
          "temporary": false
        }
      ],
      "realmRoles": ["employee"]
    },
    {
      "username": "manager1",
      "enabled": true,
      "email": "manager1@gazprom-cps.ru",
      "firstName": "Сергей",
      "lastName": "Козлов",
      "credentials": [
        {
          "type": "password",
          "value": "manager1",
          "temporary": false
        }
      ],
      "realmRoles": ["manager", "employee"]
    },
    {
      "username": "hr1",
      "enabled": true,
      "email": "hr1@gazprom-cps.ru",
      "firstName": "Елена",
      "lastName": "Сидорова",
      "credentials": [
        {
          "type": "password",
          "value": "hr1",
          "temporary": false
        }
      ],
      "realmRoles": ["hr", "employee"]
    }
  ]
}
